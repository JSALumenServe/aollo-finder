# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# Rotate the Apollo key in the Apollo developer portal; do not paste real keys here.
APOLLO_API_KEY=your-apollo-api-key
WEBHOOK_TOKEN=a-long-random-shared-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key
PORT=5000
